{
  "model": "HuggingFaceTB/SmolLM2-360M-Instruct",
  "dataset": "data/persona_lora/ramsay_style_preferences.json",
  "output_dir": "outputs/persona",
  "seed": 42,
  "validation_fraction": 0.1,
  "rank": 8,
  "alpha": 16,
  "dropout": 0.0,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj"
  ],
  "learning_rate": 1e-05,
  "batch_size": 1,
  "gradient_accumulation": 16,
  "epochs": 3,
  "beta": 0.1,
  "max_length": 512,
  "max_prompt_length": 256,
  "weight_decay": 0.0,
  "warmup_ratio": 0.03
}
